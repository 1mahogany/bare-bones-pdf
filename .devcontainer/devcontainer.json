{
    "name": "bare-bones-pdf",
    "remoteUser": "dev",
    "updateRemoteUserUID": true,
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/dev/bare-bones-pdf,type=bind",
    "workspaceFolder": "/home/dev/bare-bones-pdf",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-azuretools.vscode-containers"
            ],
            "settings": {
                "files.associations": {
                    "*.c": "c",
                    "*.h": "c"
                }
            }
        }
    }
}
